#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_VERSIONS_FILE="${SCRIPT_DIR}/../common/component-versions.env"

if [[ ! -f "${COMMON_VERSIONS_FILE}" ]]; then
  echo "Missing common versions file: ${COMMON_VERSIONS_FILE}" >&2
  return 1 2>/dev/null || exit 1
fi

# shellcheck disable=SC1090
source "${COMMON_VERSIONS_FILE}"

ARCH="arm64"
PLATFORM="linux/arm64"
INSTALLER_NAME="k8s-sealos-linux-${ARCH}.run"
