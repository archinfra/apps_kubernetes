#!/usr/bin/env bash

SEALOS_VERSION="v5.1.1"

IMAGE_REGISTRY="registry.cn-shanghai.aliyuncs.com/labring"

K8S_IMAGE_NAME="kubernetes-docker"
K8S_VERSION="v1.31.11"
K8S_IMAGE_TAR="kubernetes.tar"

HELM_IMAGE_NAME="helm"
HELM_VERSION="v3.19.2"
HELM_IMAGE_TAR="helm.tar"

CNI_PROVIDER="${CNI_PROVIDER:-cilium}"

CILIUM_IMAGE_REGISTRY="${CILIUM_IMAGE_REGISTRY:-${IMAGE_REGISTRY}}"
CILIUM_IMAGE_NAME="cilium"
CILIUM_VERSION="1.18.1"
CILIUM_IMAGE_TAR="cilium.tar"

CALICO_IMAGE_REGISTRY="registry.cn-shanghai.aliyuncs.com/labring"
CALICO_IMAGE_NAME="calico"
CALICO_VERSION="v3.26.5"
CALICO_IMAGE_TAR="calico.tar"

CNI_IMAGE_REGISTRY="${CNI_IMAGE_REGISTRY:-${CILIUM_IMAGE_REGISTRY}}"
CNI_IMAGE_NAME="${CNI_IMAGE_NAME:-${CILIUM_IMAGE_NAME}}"
CNI_VERSION="${CNI_VERSION:-${CILIUM_VERSION}}"
CNI_IMAGE_TAR="${CNI_IMAGE_TAR:-${CILIUM_IMAGE_TAR}}"
